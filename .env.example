# Database Configuration (Defaults to local SQLite db/resumes.db)
DATABASE_URL=sqlite:///db/resumes.db
# To connect to PostgreSQL instead, uncomment and configure:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_parser

# SMTP Email Alert Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
HR_EMAIL=recruiter@startup.com

# n8n Automation Webhook Endpoint
N8N_WEBHOOK_URL=http://localhost:5678/webhook/resume-ingest
